# 复制为 .env 后填写真实值；.env 已被 .gitignore / .dockerignore 排除
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview

# 可选调参
# CODE_APPROVAL_ENABLED=true
# DASK_ROW_THRESHOLD=50000
# MAX_RESULT_ROWS=200
# DEFAULT_MAX_RETRIES=1
# MAX_FOCUS_ENTITIES=5

# 子进程沙箱执行
# CODE_EXEC_TIMEOUT=30.0
# CODE_EXEC_MEM_LIMIT_MB=1024
# CODE_EXEC_CPU_TIME=30

# LLM 限流（429）/服务端错误重试：配额很低（如 RPM=3）时把次数调大
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_DELAY=2.0
# LLM_RETRY_MAX_DELAY=30.0
