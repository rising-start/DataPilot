# 复制为 .env 后填写真实值；.env 已被 .gitignore / .dockerignore 排除
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview

# 可选调参
# CODE_APPROVAL_ENABLED=true
# DASK_ROW_THRESHOLD=50000
# MAX_RESULT_ROWS=200
# DEFAULT_MAX_RETRIES=1
# MAX_FOCUS_ENTITIES=5

# 子进程沙箱执行
# CODE_EXEC_TIMEOUT=30.0
# CODE_EXEC_MEM_LIMIT_MB=1024
# CODE_EXEC_CPU_TIME=30

# LLM 限流（429）/服务端错误重试：配额很低（如 RPM=3）时把次数调大
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_DELAY=2.0
# LLM_RETRY_MAX_DELAY=30.0

# DuckDB 资源限制（防 OOM / CPU 耗尽 / 长查询挂死），可选
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=4
# DUCKDB_STATEMENT_TIMEOUT=30s

# Redis 持久化：任务记录（TaskStore）与 LangGraph checkpoint 的存储后端。
# 留空 → 内存实现（单进程、重启即丢）；配置后跨重启 / 多副本共享会话状态。
# REDIS_URL=redis://localhost:6379/0
# 任务记录在 Redis 的 TTL（秒）；0 或留空表示永不过期
# REDIS_TASK_TTL=0
